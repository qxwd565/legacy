Program "fp" {
SubProgram "opengl " {
Float 0 [_DistortionAmount]
Float 1 [_FxIntensity]
Float 2 [_FxBrightness]
Vector 3 [_FxColor]
Float 4 [_FxInverse]
SetTexture 0 [_MainTex] 2D 0
SetTexture 1 [_FxTex2] 2D 1
SetTexture 2 [_FxTex1] 2D 2
SetTexture 3 [_ShadowTex] 2D 3
"!!ARBfp1.0
OPTION ARB_precision_hint_fastest;
# 23 ALU, 5 TEX
PARAM c[6] = { program.local[0..4],
		{ 1, 0.5, 0.0099999998, 0.15002441 } };
TEMP R0;
TEMP R1;
TEMP R2;
TEMP R3;
TEX R0.w, fragment.texcoord[0], texture[0], 2D;
TEX R0.xy, fragment.texcoord[2], texture[1], 2D;
ADD R0.z, -R0.w, c[5].x;
ADD R0.xy, R0, -c[5].y;
MUL R0.xy, R0, R0.z;
MUL R0.xy, R0, c[0].x;
MAD R1.xy, R0, c[5].z, fragment.texcoord[1];
MAD R0.zw, R0.xyxy, c[5].z, fragment.texcoord[0].xyxy;
MOV result.color.w, c[5].x;
TEX R2.xyz, R1, texture[2], 2D;
TEX R0, R0.zwzw, texture[0], 2D;
TEX R1.xyz, fragment.texcoord[3], texture[3], 2D;
ADD R2.xyz, -R2, c[4].x;
MAD R2.xyz, -R2, R2, R0;
ADD R2.xyz, R2, c[2].x;
MUL R2.xyz, R2, c[3];
MUL R3.xyz, R2, c[1].x;
MAD R0.xyz, -R2, c[1].x, R0;
MAD R0.xyz, R0.w, R0, R3;
MUL R0.xyz, R0, R1;
ADD R1.xyz, R0, c[5].w;
MUL R1.xyz, R1, fragment.color.primary;
MIN result.color.xyz, R1, R0;
END
# 23 instructions, 4 R-regs
"
}
SubProgram "d3d9 " {
Float 0 [_DistortionAmount]
Float 1 [_FxIntensity]
Float 2 [_FxBrightness]
Vector 3 [_FxColor]
Float 4 [_FxInverse]
SetTexture 0 [_MainTex] 2D 0
SetTexture 1 [_FxTex2] 2D 1
SetTexture 2 [_FxTex1] 2D 2
SetTexture 3 [_ShadowTex] 2D 3
"ps_2_0
; 19 ALU, 5 TEX
dcl_2d s0
dcl_2d s1
dcl_2d s2
dcl_2d s3
def c5, 1.00000000, -0.50000000, 0.01000000, 0.15002441
dcl t0.xy
dcl t1.xy
dcl t2.xy
dcl t3.xy
dcl v0.xyz
texld r1, t0, s0
texld r0, t2, s1
add r1.x, -r1.w, c5
add r0.xy, r0, c5.y
mul r0.xy, r0, r1.x
mul r0.xy, r0, c0.x
mad r1.xy, r0, c5.z, t0
mad r0.xy, r0, c5.z, t1
texld r2, r0, s2
texld r0, t3, s3
texld r1, r1, s0
add r2.xyz, -r2, c4.x
mad_pp r2.xyz, -r2, r2, r1
add_pp r2.xyz, r2, c2.x
mul_pp r2.xyz, r2, c3
mad_pp r1.xyz, -r2, c1.x, r1
mul_pp r2.xyz, r2, c1.x
mad_pp r1.xyz, r1.w, r1, r2
mul r0.xyz, r1, r0
add_pp r1.xyz, r0, c5.w
mul_pp r1.xyz, r1, v0
min_pp r0.xyz, r1, r0
mov_pp r0.w, c5.x
mov_pp oC0, r0
"
}
