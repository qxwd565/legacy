SubProgram "opengl " {
Keywords { "FX2_SCROLL" "FX1_NORMAL" "FX2_NORMAL" "FX3_NONE" "FX3_ROTATION" "FX1_ROTATION" }
Vector 0 [_Fx1_Color]
Float 1 [_Fx1_Intensity]
Float 2 [_Fx1_Invert]
Float 3 [_Fx1_Distortion]
Vector 4 [_Fx2_Color]
Float 5 [_Fx2_Intensity]
Float 6 [_Fx2_Invert]
Float 7 [_Fx2_Blend]
Float 8 [_Fx2_Distortion]
Float 9 [_FxBrightness]
Float 10 [_FxIntensity]
SetTexture 0 [_MaskTex] 2D 0
SetTexture 1 [_Fx2_Tex] 2D 1
SetTexture 2 [_Fx1_Tex] 2D 2
SetTexture 3 [_MainTex] 2D 3
SetTexture 4 [_ShadowTex] 2D 4
"!!ARBfp1.0
OPTION ARB_precision_hint_fastest;
# 41 ALU, 5 TEX
PARAM c[12] = { program.local[0..10],
		{ 1, 0.5, 0.15002441 } };
TEMP R0;
TEMP R1;
TEMP R2;
TEMP R3;
TEMP R4;
TEMP R5;
TEX R0.xyz, fragment.texcoord[4], texture[1], 2D;
TEX R1.xyz, fragment.texcoord[2], texture[2], 2D;
TEX R5.xy, fragment.texcoord[0], texture[0], 2D;
ADD R0.xyz, -R0, c[6].x;
ABS R3.xyz, R0;
ADD R0.x, R3, -c[11].y;
ADD R1.xyz, -R1, c[2].x;
ABS R2.xyz, R1;
ADD R0.w, R2.x, -c[11].y;
MUL R0.y, R5.x, R0.w;
MUL R3.xyz, R3, c[4];
MUL R2.xyz, R2, c[0];
MUL R3.xyz, R3, c[4].w;
MUL R2.xyz, R2, c[0].w;
MUL R3.xyz, R3, c[5].x;
MUL R2.xyz, R2, c[1].x;
MUL R3.xyz, R5.y, R3;
MUL R2.xyz, R5.x, R2;
MUL R0.y, R0, c[3].x;
MUL R0.x, R5.y, R0;
MAD R0.x, R0, c[8], R0.y;
ADD R0.xy, fragment.texcoord[0], R0.x;
MUL R3.xyz, fragment.texcoord[3].y, R3;
MUL R2.xyz, R2, fragment.texcoord[3].x;
ADD R4.xyz, R2, R3;
MUL R4.xyz, R4, c[11].y;
MAD R2.xyz, R2, R3, -R4;
MOV R0.w, c[9].x;
MAD R2.xyz, R2, c[7].x, R4;
MOV result.color.w, c[11].x;
TEX R0.xyz, R0, texture[3], 2D;
TEX R1.xyz, fragment.texcoord[1], texture[4], 2D;
ADD R2.xyz, R0, R2;
MAD R2.xyz, R2, c[10].x, R0.w;
ADD R2.xyz, R2, -R0;
ADD_SAT R0.w, R5.x, R5.y;
MAD R0.xyz, R0.w, R2, R0;
MUL R0.xyz, R0, R1;
ADD R1.xyz, R0, c[11].z;
MUL R1.xyz, R1, fragment.color.primary;
MIN result.color.xyz, R1, R0;
END
# 41 instructions, 6 R-regs
"
}
SubProgram "d3d9 " {
Keywords { "FX2_SCROLL" "FX1_NORMAL" "FX2_NORMAL" "FX3_NONE" "FX3_ROTATION" "FX1_ROTATION" }
Vector 0 [_Fx1_Color]
Float 1 [_Fx1_Intensity]
Float 2 [_Fx1_Invert]
Float 3 [_Fx1_Distortion]
Vector 4 [_Fx2_Color]
Float 5 [_Fx2_Intensity]
Float 6 [_Fx2_Invert]
Float 7 [_Fx2_Blend]
Float 8 [_Fx2_Distortion]
Float 9 [_FxBrightness]
Float 10 [_FxIntensity]
SetTexture 0 [_MaskTex] 2D 0
SetTexture 1 [_Fx2_Tex] 2D 1
SetTexture 2 [_Fx1_Tex] 2D 2
SetTexture 3 [_MainTex] 2D 3
SetTexture 4 [_ShadowTex] 2D 4
"ps_2_0
; 37 ALU, 5 TEX
dcl_2d s0
dcl_2d s1
dcl_2d s2
dcl_2d s3
dcl_2d s4
def c11, -0.50000000, 0.50000000, 0.15002441, 1.00000000
dcl t0.xy
dcl t1.xy
dcl t2.xy
dcl t3.xy
dcl t4.xy
dcl v0.xyz
texld r0, t2, s2
texld r1, t4, s1
texld r5, t0, s0
add r1.xyz, -r1, c6.x
add r0.xyz, -r0, c2.x
abs r3.xyz, r1
abs r0.xyz, r0
add_pp r1.x, r0, c11
mul_pp r2.x, r5, r1
add_pp r1.x, r3, c11
mul_pp r3.xyz, r3, c4
mul_pp r0.xyz, r0, c0
mul_pp r3.xyz, r3, c4.w
mul_pp r0.xyz, r0, c0.w
mul_pp r3.xyz, r3, c5.x
mul_pp r0.xyz, r0, c1.x
mul_pp r3.xyz, r5.y, r3
mul_pp r0.xyz, r5.x, r0
mul r3.xyz, t3.y, r3
mul r0.xyz, r0, t3.x
add_pp r4.xyz, r0, r3
mul_pp r4.xyz, r4, c11.y
mad_pp r0.xyz, r0, r3, -r4
mad_pp r3.xyz, r0, c7.x, r4
mul_pp r2.x, r2, c3
mul_pp r1.x, r5.y, r1
mad_pp r1.x, r1, c8, r2
add r1.xy, t0, r1.x
mov_pp r0.x, c9
mov_pp r0.w, c11
texld r2, r1, s3
texld r1, t1, s4
add_pp r3.xyz, r2, r3
mad_pp r0.xyz, r3, c10.x, r0.x
add_pp r3.xyz, r0, -r2
add_pp_sat r0.x, r5, r5.y
mad_pp r0.xyz, r0.x, r3, r2
mul r0.xyz, r0, r1
add_pp r1.xyz, r0, c11.z
mul_pp r1.xyz, r1, v0
min_pp r0.xyz, r1, r0
mov_pp oC0, r0
"
}
