MAD R1.xyz, R2, R1, c[30].zwzw;
SLT R4.x, R1.w, c[31].z;
SGE R4.yz, R1.w, c[31].xxyw;
MOV R0.xz, R4;
DP3 R0.y, R4, c[30].zwzw;
DP3 R0.x, R3, -R0;
