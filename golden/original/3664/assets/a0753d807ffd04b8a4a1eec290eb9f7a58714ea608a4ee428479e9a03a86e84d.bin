"ps_2_0
; 37 ALU, 5 TEX
dcl_2d s0
dcl_2d s1
dcl_2d s2
dcl_2d s3
dcl_2d s4
def c11, -0.50000000, 0.50000000, 0.15002441, 1.00000000
dcl t0.xy
dcl t1.xy
dcl t2.xy
dcl t3.xy
dcl t4.xy
dcl v0.xyz
texld r0, t2, s2
texld r1, t4, s1
texld r5, t0, s0
add r1.xyz, -r1, c6.x
add r0.xyz, -r0, c2.x
abs r3.xyz, r1
abs r0.xyz, r0
add_pp r1.x, r0, c11
mul_pp r2.x, r5, r1
add_pp r1.x, r3, c11
mul_pp r3.xyz, r3, c4
mul_pp r0.xyz, r0, c0
mul_pp r3.xyz, r3, c4.w
mul_pp r0.xyz, r0, c0.w
mul_pp r3.xyz, r3, c5.x
mul_pp r0.xyz, r0, c1.x
mul_pp r3.xyz, r5.y, r3
mul_pp r0.xyz, r5.x, r0
mul r3.xyz, t3.y, r3
mul r0.xyz, r0, t3.x
add_pp r4.xyz, r0, r3
mul_pp r4.xyz, r4, c11.y
mad_pp r0.xyz, r0, r3, -r4
mad_pp r3.xyz, r0, c7.x, r4
mul_pp r2.x, r2, c3
mul_pp r1.x, r5.y, r1
mad_pp r1.x, r1, c8, r2
add r1.xy, t0, r1.x
mov_pp r0.x, c9
mov_pp r0.w, c11
texld r2, r1, s3
texld r1, t1, s4
add_pp r3.xyz, r2, r3
mad_pp r0.xyz, r3, c10.x, r0.x
add_pp r3.xyz, r0, -r2
add_pp_sat r0.x, r5, r5.y
mad_pp r0.xyz, r0.x, r3, r2
mul r0.xyz, r0, r1
add_pp r1.xyz, r0, c11.z
mul_pp r1.xyz, r1, v0
min_pp r0.xyz, r1, r0
mov_pp oC0, r0
"
}
