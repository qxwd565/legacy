TEX R1.xyz, R1, texture[2], 2D;
TEX R0.xyz, fragment.texcoord[1], texture[3], 2D;
ADD R2.yzw, R1.xxyz, R2;
MAD R2.yzw, R2, c[5].x, R0.w;
ADD R2.yzw, R2, -R1.xxyz;
MOV_SAT R0.w, R2.x;
MAD R1.xyz, R0.w, R2.yzww, R1;
MUL R0.xyz, R1, R0;
ADD R1.xyz, R0, c[6].z;
MUL R1.xyz, R1, fragment.color.primary;
