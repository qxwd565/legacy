ABS R3.xyz, R0;
ADD R0.x, R3, -c[11].y;
ADD R1.xyz, -R1, c[2].x;
ABS R2.xyz, R1;
ADD R0.w, R2.x, -c[11].y;
MUL R0.y, R5.x, R0.w;
MUL R3.xyz, R3, c[4];
MUL R2.xyz, R2, c[0];
MUL R3.xyz, R3, c[4].w;
MUL R2.xyz, R2, c[0].w;
MUL R3.xyz, R3, c[5].x;
MUL R2.xyz, R2, c[1].x;
MUL R3.xyz, R5.z, R3;
MUL R2.xyz, R5.x, R2;
MUL R0.y, R0, c[3].x;
MUL R0.x, R5.z, R0;
MAD R0.x, R0, c[8], R0.y;
ADD R0.xy, fragment.texcoord[0], R0.x;
MUL R3.xyz, fragment.texcoord[3].z, R3;
