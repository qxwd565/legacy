SubProgram "opengl " {
Keywords { "FX1_SCROLL" "FX1_NORMAL" "FX3_NONE" "FX2_NONE" "FX3_STATIC" "FX2_STATIC" }
Vector 0 [_Fx1_Color]
Float 1 [_Fx1_Intensity]
Float 2 [_Fx1_Invert]
Float 3 [_Fx1_Distortion]
Float 4 [_FxBrightness]
Float 5 [_FxIntensity]
SetTexture 0 [_MaskTex] 2D 0
SetTexture 1 [_Fx1_Tex] 2D 1
SetTexture 2 [_MainTex] 2D 2
SetTexture 3 [_ShadowTex] 2D 3
"!!ARBfp1.0
OPTION ARB_precision_hint_fastest;
# 26 ALU, 4 TEX
PARAM c[7] = { program.local[0..5],
		{ 1, 0.5, 0.15002441 } };
TEMP R0;
TEMP R1;
TEMP R2;
TEX R0.xyz, fragment.texcoord[2], texture[1], 2D;
TEX R2.x, fragment.texcoord[0], texture[0], 2D;
ADD R0.xyz, -R0, c[2].x;
ABS R2.yzw, R0.xxyz;
ADD R0.x, R2.y, -c[6].y;
MUL R0.x, R2, R0;
MUL R0.x, R0, c[3];
ADD R1.xy, fragment.texcoord[0], R0.x;
MUL R2.yzw, R2, c[0].xxyz;
MUL R2.yzw, R2, c[0].w;
MUL R2.yzw, R2, c[1].x;
MUL R2.yzw, R2.x, R2;
MOV R0.w, c[4].x;
MUL R2.yzw, R2, fragment.texcoord[3].x;
MOV result.color.w, c[6].x;
TEX R1.xyz, R1, texture[2], 2D;
TEX R0.xyz, fragment.texcoord[1], texture[3], 2D;
ADD R2.yzw, R1.xxyz, R2;
MAD R2.yzw, R2, c[5].x, R0.w;
ADD R2.yzw, R2, -R1.xxyz;
MOV_SAT R0.w, R2.x;
MAD R1.xyz, R0.w, R2.yzww, R1;
MUL R0.xyz, R1, R0;
ADD R1.xyz, R0, c[6].z;
MUL R1.xyz, R1, fragment.color.primary;
MIN result.color.xyz, R1, R0;
END
# 26 instructions, 3 R-regs
"
}
SubProgram "d3d9 " {
Keywords { "FX1_SCROLL" "FX1_NORMAL" "FX3_NONE" "FX2_NONE" "FX3_STATIC" "FX2_STATIC" }
Vector 0 [_Fx1_Color]
Float 1 [_Fx1_Intensity]
Float 2 [_Fx1_Invert]
Float 3 [_Fx1_Distortion]
Float 4 [_FxBrightness]
Float 5 [_FxIntensity]
SetTexture 0 [_MaskTex] 2D 0
SetTexture 1 [_Fx1_Tex] 2D 1
SetTexture 2 [_MainTex] 2D 2
SetTexture 3 [_ShadowTex] 2D 3
"ps_2_0
; 23 ALU, 4 TEX
dcl_2d s0
dcl_2d s1
dcl_2d s2
dcl_2d s3
def c6, -0.50000000, 0.15002441, 1.00000000, 0
dcl t0.xy
dcl t1.xy
dcl t2.xy
dcl t3.x
dcl v0.xyz
texld r0, t2, s1
texld r4, t0, s0
add r0.xyz, -r0, c2.x
abs r0.xyz, r0
add_pp r1.x, r0, c6
mul_pp r1.x, r4, r1
mul_pp r1.x, r1, c3
add r1.xy, t0, r1.x
mul_pp r0.xyz, r0, c0
mul_pp r0.xyz, r0, c0.w
mul_pp r0.xyz, r0, c1.x
mul_pp r0.xyz, r4.x, r0
mul r3.xyz, r0, t3.x
mov_pp r0.x, c4
mov_pp r0.w, c6.z
texld r2, r1, s2
texld r1, t1, s3
add_pp r3.xyz, r2, r3
mad_pp r0.xyz, r3, c5.x, r0.x
add_pp r3.xyz, r0, -r2
mov_pp_sat r0.x, r4
mad_pp r0.xyz, r0.x, r3, r2
mul r0.xyz, r0, r1
add_pp r1.xyz, r0, c6.y
mul_pp r1.xyz, r1, v0
min_pp r0.xyz, r1, r0
mov_pp oC0, r0
"
}
