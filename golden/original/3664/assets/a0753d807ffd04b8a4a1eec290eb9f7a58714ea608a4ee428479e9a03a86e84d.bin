mul r1.z, r1, c7.x
add r0, r0, -v3
add oT3.x, r1.z, c29.z
mad oD0, r0, c25.x, v3
mov oT0.xy, r1
mad oT1.xy, v2, c26, c26.zwzw
mov oT5.xy, r1
dp4 oPos.w, v0, c3
dp4 oPos.z, v0, c2
dp4 oPos.y, v0, c1
dp4 oPos.x, v0, c0
mov oT3.z, c29
"
}
