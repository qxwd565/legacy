OPTION ARB_precision_hint_fastest;
# 41 ALU, 5 TEX
PARAM c[12] = { program.local[0..10],
		{ 1, 0.5, 0.15002441 } };
TEMP R0;
TEMP R1;
TEMP R2;
TEMP R3;
TEMP R4;
TEMP R5;
TEX R0.xyz, fragment.texcoord[4], texture[1], 2D;
TEX R1.xyz, fragment.texcoord[2], texture[2], 2D;
TEX R5.xy, fragment.texcoord[0], texture[0], 2D;
ADD R0.xyz, -R0, c[6].x;
ABS R3.xyz, R0;
ADD R0.x, R3, -c[11].y;
ADD R1.xyz, -R1, c[2].x;
ABS R2.xyz, R1;
ADD R0.w, R2.x, -c[11].y;
MUL R0.y, R5.x, R0.w;
MUL R3.xyz, R3, c[4];
MUL R2.xyz, R2, c[0];
MUL R3.xyz, R3, c[4].w;
MUL R2.xyz, R2, c[0].w;
MUL R3.xyz, R3, c[5].x;
MUL R2.xyz, R2, c[1].x;
MUL R3.xyz, R5.y, R3;
MUL R2.xyz, R5.x, R2;
MUL R0.y, R0, c[3].x;
MUL R0.x, R5.y, R0;
MAD R0.x, R0, c[8], R0.y;
ADD R0.xy, fragment.texcoord[0], R0.x;
MUL R3.xyz, fragment.texcoord[3].y, R3;
MUL R2.xyz, R2, fragment.texcoord[3].x;
ADD R4.xyz, R2, R3;
MUL R4.xyz, R4, c[11].y;
MAD R2.xyz, R2, R3, -R4;
