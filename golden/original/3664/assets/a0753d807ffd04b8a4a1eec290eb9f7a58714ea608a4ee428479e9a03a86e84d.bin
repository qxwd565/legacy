add_pp_sat r0.x, r5, r5.y
mad_pp r0.xyz, r0.x, r3, r2
mul r0.xyz, r0, r1
add_pp r1.xyz, r0, c11.z
mul_pp r1.xyz, r1, v0
min_pp r0.xyz, r1, r0
