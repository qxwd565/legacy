SubProgram "opengl " {
Keywords { "FX1_NORMAL" "FX2_NORMAL" "FX3_NONE" "FX3_ROTATION" "FX2_ROTATION" "FX1_ROTATION" }
Vector 0 [_Fx1_Color]
Float 1 [_Fx1_Intensity]
Float 2 [_Fx1_Invert]
Float 3 [_Fx1_Distortion]
Vector 4 [_Fx2_Color]
Float 5 [_Fx2_Intensity]
Float 6 [_Fx2_Invert]
