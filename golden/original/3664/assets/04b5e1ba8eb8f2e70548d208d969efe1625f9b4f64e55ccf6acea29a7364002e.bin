Program "fp" {
SubProgram "opengl " {
Vector 0 [_FxColor1]
Vector 1 [_FxColor2]
Float 2 [_FxBlend]
Float 3 [_FxIntensity]
Float 4 [_FxBrightness]
Float 5 [_FxInverse]
SetTexture 0 [_MainTex] 2D 0
SetTexture 1 [_FxTex1] 2D 1
SetTexture 2 [_FxTex2] 2D 2
SetTexture 3 [_ShadowTex] 2D 3
"!!ARBfp1.0
OPTION ARB_precision_hint_fastest;
# 25 ALU, 4 TEX
PARAM c[7] = { program.local[0..5],
		{ 1, 2, 0.5, 0.15002441 } };
TEMP R0;
TEMP R1;
TEMP R2;
TEMP R3;
TEMP R4;
TEX R2.xyz, fragment.texcoord[1], texture[1], 2D;
TEX R3.xyz, fragment.texcoord[2], texture[2], 2D;
TEX R0, fragment.texcoord[0], texture[0], 2D;
TEX R1.xyz, fragment.texcoord[3], texture[3], 2D;
MOV R1.w, c[6].y;
MUL R2.w, R1, c[1];
MUL R3.xyz, R3, c[1];
MUL R3.xyz, R3, R2.w;
MUL R1.w, R1, c[0];
MUL R2.xyz, R2, c[0];
MUL R2.xyz, R2, R1.w;
ADD R4.xyz, R2, R3;
MUL R4.xyz, R4, c[6].z;
MAD R2.xyz, R2, R3, -R4;
MAD R2.xyz, R2, c[2].x, R4;
ADD R2.xyz, -R2, c[5].x;
MAD R2.xyz, -R2, c[3].x, R0;
ADD R2.xyz, R2, c[4].x;
ADD R0.xyz, R0, -R2;
MAD R0.xyz, R0.w, R0, R2;
MUL R0.xyz, R0, R1;
ADD R1.xyz, R0, c[6].w;
MUL R1.xyz, R1, fragment.color.primary;
MIN result.color.xyz, R1, R0;
MOV result.color.w, c[6].x;
END
# 25 instructions, 5 R-regs
"
}
