Shader "Custom/Card/UnlitScroll2LayerPremium" {
Properties {
 _MainTex ("Base (RGB)", 2D) = "white" {}
 _ShadowTex ("Shadow (RGB)", 2D) = "white" {}
 _FxTex1 ("FX1 Texture (RGB)", 2D) = "white" {}
 _FxColor1 ("FX1 Color", Color) = (1,1,1,0)
 _ScrollX1 ("FX1 Scroll X Speed", Float) = 0
 _ScrollY1 ("FX1 Scroll Y Speed", Float) = 0
 _Scale1 ("FX1 Scale", Float) = 1
 _FxTex2 ("FX2 Texture (RGB)", 2D) = "white" {}
 _FxColor2 ("FX2 Color", Color) = (1,1,1,0)
 _ScrollX2 ("FX2 Scroll X Speed", Float) = 0
 _ScrollY2 ("FX2 Scroll Y Speed", Float) = 0
 _Scale2 ("FX2 Scale", Float) = 1
 _FxBlend ("FX Blend", Range(0,1)) = 0.5
 _FxIntensity ("FX Intensity", Float) = 2
 _FxBrightness ("FX Brightness", Float) = 0
 _FxInverse ("FX Inverse", Float) = 0
 _LightingBlend ("Ambient Lighting Blend", Float) = 0
}
SubShader { 
 Tags { "RenderType"="Opaque" "Highlight"="True" }
 Pass {
  Tags { "RenderType"="Opaque" "Highlight"="True" }
  BindChannels {
   Bind "color", Color
   Bind "texcoord", TexCoord
  }
  Fog {
   Color (0,0,0,1)
  }
Program "vp" {
SubProgram "opengl " {
Bind "vertex" Vertex
Bind "color" Color
Bind "texcoord" TexCoord0
Bind "texcoord1" TexCoord1
Vector 6 [_Time]
Vector 7 [_LightColor0]
Float 8 [_ScrollX1]
Float 9 [_ScrollY1]
Float 10 [_Scale1]
Float 11 [_ScrollX2]
Float 12 [_ScrollY2]
Float 13 [_Scale2]
Float 14 [_LightingBlend]
Vector 15 [_MainTex_ST]
"!!ARBvp1.0
# 18 ALU
PARAM c[16] = { { 2 },
		state.lightmodel.ambient,
		state.matrix.mvp,
		program.local[6..15] };
TEMP R0;
MOV R0.x, c[0];
MUL R0, R0.x, c[1];
ADD R0, R0, c[7];
ADD R0, R0, -vertex.color;
MAD result.color, R0, c[14].x, vertex.color;
MOV R0.z, c[6].x;
MAD R0.y, R0.z, c[9].x, vertex.texcoord[0];
MAD R0.x, R0.z, c[8], vertex.texcoord[0];
MUL result.texcoord[1].xy, R0, c[10].x;
MAD R0.y, R0.z, c[12].x, vertex.texcoord[0];
MAD R0.x, R0.z, c[11], vertex.texcoord[0];
MAD result.texcoord[0].xy, vertex.texcoord[0], c[15], c[15].zwzw;
MUL result.texcoord[2].xy, R0, c[13].x;
MAD result.texcoord[3].xy, vertex.texcoord[1], c[15], c[15].zwzw;
DP4 result.position.w, vertex.position, c[5];
DP4 result.position.z, vertex.position, c[4];
DP4 result.position.y, vertex.position, c[3];
DP4 result.position.x, vertex.position, c[2];
END
# 18 instructions, 1 R-regs
"
}
SubProgram "d3d9 " {
Bind "vertex" Vertex
Bind "color" Color
Bind "texcoord" TexCoord0
Bind "texcoord1" TexCoord1
Matrix 0 [glstate_matrix_mvp]
Vector 4 [glstate_lightmodel_ambient]
Vector 5 [_Time]
Vector 6 [_LightColor0]
Float 7 [_ScrollX1]
Float 8 [_ScrollY1]
Float 9 [_Scale1]
Float 10 [_ScrollX2]
Float 11 [_ScrollY2]
Float 12 [_Scale2]
Float 13 [_LightingBlend]
Vector 14 [_MainTex_ST]
"vs_2_0
; 21 ALU
def c15, 2.00000000, 0, 0, 0
dcl_position0 v0
dcl_texcoord0 v1
dcl_texcoord1 v2
dcl_color0 v3
mov r0, c4
mul r0, c15.x, r0
add r0, r0, c6
add r0, r0, -v3
mad oD0, r0, c13.x, v3
mov r0.y, c8.x
mov r0.x, c7
mad r0.y, c5.x, r0, v1
mad r0.x, c5, r0, v1
mul oT1.xy, r0, c9.x
mov r0.y, c11.x
mov r0.x, c10
mad r0.y, c5.x, r0, v1
mad r0.x, c5, r0, v1
mad oT0.xy, v1, c14, c14.zwzw
mul oT2.xy, r0, c12.x
mad oT3.xy, v2, c14, c14.zwzw
dp4 oPos.w, v0, c3
dp4 oPos.z, v0, c2
dp4 oPos.y, v0, c1
dp4 oPos.x, v0, c0
"
}
SubProgram "d3d11 " {
Bind "vertex" Vertex
Bind "color" Color
Bind "texcoord" TexCoord0
Bind "texcoord1" TexCoord1
ConstBuffer "$Globals" 160
Vector 16 [_LightColor0]
Float 64 [_ScrollX1]
Float 68 [_ScrollY1]
Float 72 [_Scale1]
Float 112 [_ScrollX2]
Float 116 [_ScrollY2]
Float 120 [_Scale2]
Float 140 [_LightingBlend]
Vector 144 [_MainTex_ST]
ConstBuffer "UnityPerCamera" 128
Vector 0 [_Time]
ConstBuffer "UnityPerDraw" 336
Matrix 0 [glstate_matrix_mvp]
ConstBuffer "UnityPerFrame" 208
Vector 64 [glstate_lightmodel_ambient]
BindCB  "$Globals" 0
BindCB  "UnityPerCamera" 1
BindCB  "UnityPerDraw" 2
BindCB  "UnityPerFrame" 3
