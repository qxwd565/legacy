ADD R1.xyz, -R0.w, c[0].zxww;
MUL R1.xyz, R1, R1;
MAD R2.xyz, R1, c[18].xyxw, c[18].zwzw;
MAD R2.xyz, R2, R1, c[19].xyxw;
MAD R2.xyz, R2, R1, c[19].zwzw;
ADD result.texcoord[1].xy, R0, c[0].x;
ADD R0.xyz, -R1.w, c[0].zxww;
MUL R0.xyz, R0, R0;
MAD R3.xyz, R0, c[18].xyxw, c[18].zwzw;
