Program "fp" {
SubProgram "opengl " {
Float 0 [_DistortionAmount]
Float 1 [_FxBrightness]
Float 2 [_FxIntensity]
Vector 3 [_FxColor]
Float 4 [_FxInverse]
SetTexture 0 [_MainTex] 2D 0
SetTexture 1 [_FxTex2] 2D 1
SetTexture 2 [_FxTex1] 2D 2
SetTexture 3 [_ShadowTex] 2D 3
"!!ARBfp1.0
OPTION ARB_precision_hint_fastest;
# 23 ALU, 5 TEX
PARAM c[6] = { program.local[0..4],
		{ 1, 0.5, 0.0099999998, 0.15002441 } };
TEMP R0;
TEMP R1;
TEMP R2;
TEMP R3;
TEX R0.w, fragment.texcoord[0], texture[0], 2D;
TEX R0.xy, fragment.texcoord[2], texture[1], 2D;
ADD R0.z, -R0.w, c[5].x;
ADD R0.xy, R0, -c[5].y;
MUL R0.xy, R0, R0.z;
MUL R0.xy, R0, c[0].x;
MAD R1.xy, R0, c[5].z, fragment.texcoord[1];
MAD R0.zw, R0.xyxy, c[5].z, fragment.texcoord[0].xyxy;
MOV result.color.w, c[5].x;
TEX R2.xyz, R1, texture[2], 2D;
