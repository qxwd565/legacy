mul r0.z, c5.x, r0.w
mad r1.x, r0.z, c17.y, c17
frc r2.z, r1.x
add oT1.xy, r0, c17.x
mov r0, c4
mul r1, c20.x, r0
add r1, r1, c6
add r1, r1, -v3
mad r3.x, r2.z, c17.z, c17.w
mov r0.y, c13.x
mov r0.x, c12
add r2.zw, r0.xyxy, c17.x
sincos r0.xy, r3.x, c18.xyzw, c19.xyzw
add r0.zw, r2.xyxy, -r2
mul r2.zw, r0, c14.x
mul r0.zw, r2.w, r0.xyyx
mov r0.y, -r0
mad r0.xy, r2.z, r0, r0.zwzw
add oT2.xy, r0, c17.x
mad oD0, r1, c15.x, v3
mov oT0.xy, r2
mad oT3.xy, v2, c16, c16.zwzw
dp4 oPos.w, v0, c3
dp4 oPos.z, v0, c2
dp4 oPos.y, v0, c1
dp4 oPos.x, v0, c0
