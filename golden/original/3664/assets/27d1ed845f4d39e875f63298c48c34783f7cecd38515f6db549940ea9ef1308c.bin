SLT R1.x, R1.w, c[21].z;
SGE R1.yz, R1.w, c[21].xxyw;
SLT R4.x, R2.w, c[21].z;
SGE R4.yz, R2.w, c[21].xxyw;
MOV R0.xz, R4;
DP3 R0.y, R4, c[20].zwzw;
